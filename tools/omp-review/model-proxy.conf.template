server {
  listen 8080;
  client_max_body_size 64m;
  location ~ ^/v1/(messages|chat/completions)$ {
    limit_except POST { deny all; }
    proxy_pass https://inference-api.nvidia.com;
    proxy_http_version 1.1;
    proxy_set_header Host inference-api.nvidia.com;
    proxy_set_header Authorization "Bearer ${OMP_REVIEW_INFERENCE_HUB_API_KEY}";
    proxy_set_header x-api-key "";
    proxy_set_header Connection "";
    proxy_ssl_server_name on;
    proxy_ssl_name inference-api.nvidia.com;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 3;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
  }
  location / { return 403; }
}
