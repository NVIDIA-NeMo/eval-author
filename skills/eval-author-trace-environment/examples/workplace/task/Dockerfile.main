FROM @BASE_IMAGE@
RUN useradd --create-home --uid 1000 solver
COPY main/ /opt/workplace/
RUN chmod -R a-w /opt/workplace && mkdir /workspace && chown solver:solver /workspace
WORKDIR /workspace
USER solver
CMD ["sleep", "infinity"]
